{
  "name": "@openrep/sdk",
  "version": "0.1.0",
  "description": "Core library for OpenRep — a platform-agnostic reputation layer for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./names": {
      "import": "./dist/names.js",
      "types": "./dist/names.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "tsc"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Coding-With-Josh/openrep.git"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@noble/ed25519": "^3.2.0"
  }
}
