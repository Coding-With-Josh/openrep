{
  "name": "@openrep/cli",
  "version": "0.1.0",
  "description": "First-class CLI for OpenRep — pipeline-friendly agent reputation management",
  "type": "module",
  "bin": {
    "openrep": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openrep/sdk": "workspace:*",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
