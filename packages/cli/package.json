{
  "name": "@openrep/cli",
  "version": "0.1.0",
  "description": "First-class CLI for OpenRep, the pipeline-friendly agent reputation management layer",
  "type": "module",
  "bin": {
    "openrep": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "tsc && vitest run",
    "prepack": "tsc"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Coding-With-Josh/openrep.git"
  },
  "dependencies": {
    "@openrep/sdk": "workspace:^",
    "@noble/ed25519": "^3.2.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}